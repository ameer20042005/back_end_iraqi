{
  "info": {
    "name": "Iraqi District Correction API",
    "description": "ميزة ضمن الباك اند الحالي على المنفذ 8000. اضبط district_api_key من متغيرات المجموعة؛ لا يوجد مفتاح حقيقي داخل الملف.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "district_base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "district_api_key", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health — الخادم يعمل",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{district_base_url}}/health", "host": ["{{district_base_url}}"], "path": ["health"] },
        "description": "200 يعني أن عملية FastAPI تعمل؛ لا يفحص قاعدة البيانات ولا يحتاج مفتاحاً."
      }
    },
    {
      "name": "Ready — الكتالوج والإعدادات جاهزان",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{district_base_url}}/v1/district-correction/ready", "host": ["{{district_base_url}}"], "path": ["v1", "district-correction", "ready"] },
        "description": "200 عند تحميل الكتالوج وضبط المفتاح، وإلا 503. لا يستدعي LLM."
      }
    },
    {
      "name": "District Correction",
      "item": [
        {
          "name": "تصحيح دفعة — محافظتان وعنوان مفصول",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{district_api_key}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"FUHOOD\",\n  \"cases\": [\n    {\"excelSequence\": 1, \"stateName\": \"DHI_QAR\", \"stateCode\": \"DHI\", \"district\": \"شطره\", \"address\": \"الشطرة قرب السوق العام\"},\n    {\"excelSequence\": 2, \"stateName\": \"BAGHDAD\", \"stateCode\": \"BGD\", \"district\": \"الكرادة شارع الرشيد، بناية 10\", \"address\": \"\"},\n    {\"excelSequence\": 3, \"stateName\": \"BAGHDAD\", \"stateCode\": \"BGD\", \"district\": \"حي غير واضح\", \"address\": \"قرب الجامع\"}\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{district_base_url}}/v1/district-correction", "host": ["{{district_base_url}}"], "path": ["v1", "district-correction"] },
            "description": "أرسل دفعة واحدة لشركة واحدة. كل صف يحوي stateCode الخاص به. نتائج الحالات تبقى بنفس ترتيب الإدخال."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
            "const body = pm.response.json();",
            "pm.test('All three cases returned', function () { pm.expect(body.cases.length).to.eql(3); });",
            "pm.test('Canonical names and address split', function () { pm.expect(body.cases[0].correctDistrict).to.eql('الشطرة'); pm.expect(body.cases[0].addressDetails).to.eql('قرب السوق العام'); pm.expect(body.cases[1].correctDistrict).to.eql('الكرادة'); });",
            "pm.test('Unresolved input is preserved', function () { pm.expect(body.cases[2].status).to.eql('UNRESOLVED'); pm.expect(body.cases[2].correctDistrict).to.eql('حي غير واضح'); });"
          ] } }]
        },
        {
          "name": "مفتاح خاطئ — 401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "wrong-key", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\"companyName\":\"FUHOOD\",\"cases\":[{\"excelSequence\":1,\"stateCode\":\"DHI\",\"district\":\"الشطرة\"}]}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{district_base_url}}/v1/district-correction", "host": ["{{district_base_url}}"], "path": ["v1", "district-correction"] },
            "description": "يتحقق من رفض المفتاح غير الصحيح كما في بقية خدمات المشروع."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 401', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "مفتاح مفقود — 422",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": { "mode": "raw", "raw": "{\"companyName\":\"FUHOOD\",\"cases\":[{\"excelSequence\":1,\"stateCode\":\"DHI\",\"district\":\"الشطرة\"}]}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{district_base_url}}/v1/district-correction", "host": ["{{district_base_url}}"], "path": ["v1", "district-correction"] },
            "description": "الهيدر إلزامي؛ غيابه يرجع 422 مثل بقية الراوترات."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 422', function () { pm.response.to.have.status(422); });"] } }]
        },
        {
          "name": "شركة غير معروفة — 404",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-Key", "value": "{{district_api_key}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\"companyName\":\"UNKNOWN\",\"cases\":[{\"excelSequence\":1,\"stateCode\":\"BGD\",\"district\":\"الكرادة\"}]}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{district_base_url}}/v1/district-correction", "host": ["{{district_base_url}}"], "path": ["v1", "district-correction"] },
            "description": "يتحقق من عزل كتالوجات الشركات."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 404', function () { pm.response.to.have.status(404); });"] } }]
        }
      ]
    }
  ]
}

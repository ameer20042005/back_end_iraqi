# قالب متغيرات البيئة — لا تضع أي قيمة سرية حقيقية في هذا الملف.
#
# ملاحظة: التطبيق لا يحمّل ملف .env تلقائياً حالياً. للتشغيل على RunPod،
# أضف القيمة كـ Environment Variable من إعدادات الـ Pod/Template. وللتشغيل
# المحلي صدّر المتغير في بيئة العملية قبل تشغيل start.sh أو uvicorn.
#
# إعدادات الموديل ومفاتيح كل الخدمات (بما فيها تصحيح المناطق) ثابتة في app/config.py.
# متغيرات تصحيح المناطق الاختيارية أدناه تُقرأ من بيئة العملية عبر app/config.py.

# مطلوب لتنزيل Gemma إذا كان الموديل gated أو المستودع خاصاً.
# أنشئ توكن Read من: https://huggingface.co/settings/tokens
HF_TOKEN=

# اختيارية؛ الافتراضي assets/address والكتالوج داخل app/features/district_correction/data.
# يُعاد بناء الكتالوج تلقائياً عند الإقلاع إذا كان أي ملف Excel أحدث منه.
# DISTRICT_SOURCE_DIR=
# DISTRICT_DATABASE_PATH=

# اختيارية للحالات الغامضة فقط. بلا رابط وموديل لا يُستدعى LLM.
# DISTRICT_LLM_MAX_CASES: أقصى عدد حالات تُرسل للـLLM في الطلب الواحد؛ الباقي يرجع LLM_LIMIT_EXCEEDED.
# DISTRICT_LLM_BASE_URL=http://127.0.0.1:18001/v1
# DISTRICT_LLM_MODEL=ameer4wisam/gemma-iraqi-10k-merged
# DISTRICT_LLM_API_KEY=
# DISTRICT_LLM_TIMEOUT_SECONDS=15
# DISTRICT_LLM_MAX_CASES=100
